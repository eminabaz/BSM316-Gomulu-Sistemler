 134:Core/Src/main.c ****         }
 135:Core/Src/main.c ****         if (duration >= 5000) { // 5 saniye basılı tutulursa (Test için)
 136:Core/Src/main.c ****          HAL_NVIC_SystemReset(); // İşlemciyi yazılımsal olarak yeniden başlatır
 137:Core/Src/main.c ****         }
 138:Core/Src/main.c ****         else if (duration > 50) // Kısa basıldıysa (En az 50ms, gürültü engelleme için)
 139:Core/Src/main.c ****         {
 140:Core/Src/main.c ****             blink_count++; // Değeri 1 artır [cite: 43]
